  CKPT --> LOAD
  INDEX --> LOAD
  REQUEST --> USER
  LOAD --> USER
  USER --> SCORE
  INDEX --> SCORE
  SCORE --> FILTER
  REQUEST -->|全部已看 ID| FILTER
  FILTER --> RESULT
  TEST -->|选模完成后评估| RESULT
  INDEX -.-> ANN
